# syntax=docker/dockerfile:1.7
FROM golang:1.27.1-trixie AS build
WORKDIR /src
RUN apt-get update && apt-get install -y --no-install-recommends bash \
    && rm -rf /var/lib/apt/lists/*
COPY go.mod go.sum ./
RUN --mount=type=secret,id=host_ca,required=false \
    if [ -s /run/secrets/host_ca ]; then cp /run/secrets/host_ca /usr/local/share/ca-certificates/host.crt && update-ca-certificates; fi; \
    go mod download
COPY cmd/ cmd/
COPY harness/ harness/
COPY internal/ internal/
RUN mkdir -p /workspace && go test ./cmd/unreal-agent-desktop-bridge ./harness/llm/clients/anthropic ./harness/llm/clients/chatcompatible
RUN CGO_ENABLED=0 go build -trimpath -buildvcs=false -o /out/unreal-agent-desktop-bridge ./cmd/unreal-agent-desktop-bridge

FROM debian:trixie-slim
RUN apt-get update && apt-get install -y --no-install-recommends bash ca-certificates tini git passwd python3 python3-venv python3-pip \
    && rm -rf /var/lib/apt/lists/* && mkdir -p /workspace /state /home/agent \
    && groupadd --gid 10001 agent && useradd --uid 10001 --gid 10001 --home-dir /home/agent --shell /bin/bash agent \
    && chmod 1777 /state && git config --file /home/agent/.gitconfig --add safe.directory /workspace \
    && chown 10001:10001 /workspace /home/agent /home/agent/.gitconfig
RUN --mount=type=secret,id=host_ca,required=false \
    if [ -s /run/secrets/host_ca ]; then cp /run/secrets/host_ca /usr/local/share/ca-certificates/host.crt && update-ca-certificates; fi
COPY --from=build /out/unreal-agent-desktop-bridge /usr/local/bin/unreal-agent-desktop-bridge
COPY desktop/worker/decision_worker.py /usr/local/lib/unrealcode/decision_worker.py
COPY LICENSE /usr/share/doc/unreal-agent/LICENSE
COPY desktop/third-party-licenses/ /usr/share/doc/unrealcode/third-party-licenses/
ENV HOME=/home/agent SHELL=/bin/bash UNREAL_DESKTOP_STATE=/state
USER 10001:10001
WORKDIR /workspace
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/unreal-agent-desktop-bridge"]
