{
  "name": "unrealcode",
  "version": "1.1.0",
  "private": true,
  "description": "UnrealCode Windows desktop application built on Unreal Agent",
  "author": "UnrealCode contributors",
  "license": "MIT",
  "main": "./out/main/index.js",
  "scripts": {
    "host-files:build": "node scripts/build-host-files.mjs",
    "pretest": "npm run host-files:build",
    "prebuild:code": "npm run host-files:build && npm run computer:build",
    "predev": "npm run host-files:build && npm run computer:build",
    "dev": "electron-vite dev",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "build:code": "electron-vite build",
    "licenses:generate": "node scripts/generate-notices.mjs && node scripts/computer-notices.mjs",
    "brand:generate": "node scripts/generate-brand-assets.mjs",
    "build:win": "npm run typecheck && npm run build:code && npm run licenses:generate && node scripts/build-release.mjs",
    "build:release:unsigned": "npm run typecheck && npm run build:code && npm run licenses:generate && node scripts/build-release.mjs --unsigned-public",
    "test": "vitest run",
    "build:stable": "npm run typecheck && npm run build:code && npm run licenses:generate && node scripts/build-release.mjs --stable",
    "computer:build": "node scripts/build-computer-host.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@napi-rs/canvas": "1.0.9",
    "@xterm/xterm": "^6.0.0",
    "ajv": "8.20.0",
    "electron-updater": "6.8.9",
    "lucide-react": "^1.48.0",
    "mime-types": "3.0.2",
    "monaco-editor": "0.57.0",
    "motion": "^13.4.4",
    "node-pty": "^1.1.0",
    "pdfjs-dist": "6.3.289",
    "playwright-core": "1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^5.0.2"
  },
  "build": {
    "appId": "ai.mcshotty.unrealcode",
    "productName": "UnrealCode",
    "npmRebuild": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json",
      "node_modules/**/*",
      "!node_modules/**/{test,tests,__tests__}/**",
      "!node_modules/**/*.{test,spec}.{js,cjs,mjs,ts,tsx}"
    ],
    "extraResources": [
      {
        "from": "generated/unrealcode-host-files.exe",
        "to": "host-files/unrealcode-host-files.exe"
      },
      {
        "from": "generated/computer-host",
        "to": "computer-host",
        "filter": [
          "UnrealCode.ComputerHost.exe",
          "manifest.json"
        ]
      },
      {
        "from": "assets/unrealcode-icon.png",
        "to": "assets/unrealcode-icon.png"
      },
      {
        "from": "third-party-licenses",
        "to": "licenses"
      },
      {
        "from": "builtin-skills",
        "to": "builtin-skills"
      },
      {
        "from": "../",
        "to": "backend",
        "filter": [
          "go.mod",
          "go.sum",
          "LICENSE",
          "Dockerfile.desktop",
          ".dockerignore",
          "cmd/**/*",
          "harness/**/*",
          "internal/**/*",
          "desktop/worker/**/*",
          "desktop/builtin-skills/**/*",
          "desktop/third-party-licenses/**/*",
          "!**/__pycache__/**",
          "!**/*.pyc"
        ]
      },
      {
        "from": "generated/release-policy.json",
        "to": "release-policy.json"
      }
    ],
    "asarUnpack": [
      "node_modules/node-pty/**/*",
      "node_modules/@napi-rs/canvas/**/*",
      "node_modules/@napi-rs/canvas-win32-x64-msvc/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/unrealcode-icon.ico"
    },
    "publish": {
      "provider": "github",
      "owner": "MCShotty",
      "repo": "UnrealCode",
      "releaseType": "draft"
    },
    "generateUpdatesFilesForAllChannels": false,
    "artifactName": "UnrealCode-Setup-${version}.${ext}"
  }
}
