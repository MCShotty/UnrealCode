{
  "name": "unrealcode",
  "version": "0.2.0",
  "private": true,
  "description": "UnrealCode Windows desktop application built on Unreal Agent",
  "author": "UnrealCode contributors",
  "license": "MIT",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "build:code": "electron-vite build",
    "build:win": "npm run typecheck && npm run build:code && electron-builder --win nsis",
    "test": "vitest run"
  },
  "dependencies": {
    "@xterm/xterm": "^6.0.0",
    "lucide-react": "^1.48.0",
    "motion": "^13.4.4",
    "node-pty": "^1.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^5.0.2"
  },
  "build": {
    "appId": "ai.mcshotty.unrealcode",
    "productName": "UnrealCode",
    "npmRebuild": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "../",
        "to": "backend",
        "filter": [
          "go.mod",
          "go.sum",
          "LICENSE",
          "Dockerfile.desktop",
          ".dockerignore",
          "cmd/**/*",
          "harness/**/*",
          "internal/**/*",
          "desktop/worker/**/*"
        ]
      }
    ],
    "asarUnpack": ["node_modules/node-pty/**/*"],
    "win": {
      "target": "nsis",
      "icon": "assets/unrealcode-icon.ico"
    }
  }
}
